# ---- Secrets: NEVER commit real env files ----
.env
.env.*
!.env.example
*.pem
*.key
*.secret
credentials*.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.venv*/
venv/

# ---- Tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Models (downloaded at build/probe time, ~5MB each) ----
models/*.task

# ---- Runtime artifacts ----
*.log
logs/
recordings/
captures/
.edge.pid

# ---- IDE / OS ----
.idea/
.vscode/
Thumbs.db
.DS_Store

# ---- Camera calibration local profiles ----
configs/local/
