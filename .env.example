# neuro_int environment template.
# Copy to .env and adjust. .env is gitignored — never commit real values.

# --- Brain (docker) ---
NEUROINT_WS_PORT=8765
NEUROINT_LOG_LEVEL=INFO

# --- Edge (host agent) ---
# WebSocket endpoint edge connects to (must stay loopback: brain port is
# published on 127.0.0.1 only, see docker-compose.yml).
NEUROINT_WS_URL=ws://127.0.0.1:8765

# Local web UI (camera + bones overlay + gesture editor), loopback only.
NEUROINT_UI_ENABLED=1
NEUROINT_UI_PORT=8756

# Frame pipeline: capture fps target and JPEG quality (1-100).
NEUROINT_CAPTURE_FPS=30
NEUROINT_JPEG_QUALITY=80

# --- Camera tuning (PS3 Eye via pseyepy, device-specific) ---
# Camera index for pseyepy / OpenCV fallback.
NEUROINT_CAMERA_INDEX=0
# Sensor fps: 30 = longer exposure = brighter in a dark room; 60 = smoother
# motion. Pick interactively: make tune (stop edge first: camera is exclusive)
NEUROINT_CAMERA_FPS=30
# Manual gain (0-63) and exposure (0-255); -1 = library defaults (dark/noisy).
NEUROINT_GAIN=-1
NEUROINT_EXPOSURE=-1
